<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>shitbotteam.ultra</groupId><artifactId>ultra-minecraft-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>ultra-minecraft-client</artifactId>
  <name>ShitBotUltra Minecraft Bridge Client</name>
  <dependencies>
    <dependency><groupId>shitbotteam.ultra</groupId><artifactId>ultra-minecraft-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.12.0</version></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.2</version></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/..</directory><targetPath>META-INF</targetPath><filtering>false</filtering><includes><include>LICENSE</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><archive><manifestEntries><Automatic-Module-Name>shitbotteam.ultra.minecraft.bridge</Automatic-Module-Name></manifestEntries></archive></configuration></plugin></plugins>
  </build>
</project>
